rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function validStatus() {
      return !('status' in request.resource.data)
        || request.resource.data.status in ['Pending', 'Processing', 'Success'];
    }

    function proofOk() {
      return !('proof' in request.resource.data)
        || !(request.resource.data.proof is string)
        || request.resource.data.proof.size() <= 950000;
    }

    match /complaints/{complaintId} {
      allow read: if true;

      allow create: if validStatus()
        && proofOk()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120;

      allow update: if validStatus();
      allow delete: if true;
    }

    match /logins/{loginId} {
      allow read: if true;

      allow create, update: if request.resource.data.uid is string
        && request.resource.data.uid.size() > 0
        && request.resource.data.uid.size() <= 80
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.userId.size() <= 20
        && request.resource.data.password is string
        && request.resource.data.password.size() <= 128;

      allow delete: if true;
    }

    match /chats/{chatId} {
      allow read: if true;

      allow create: if request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.role in ['user', 'system', 'support']
        && (!('userId' in request.resource.data)
          || (request.resource.data.userId is string
            && request.resource.data.userId.size() <= 20));

      allow update, delete: if true;
    }
  }
}
